# AlbumFlow web — Apache / LiteSpeed (cPanel).
# Vite copies everything in public/ to the build output, so this ships with dist/.

# ---------------------------------------------------------------------------
# Single-page app routing.
#
# The editor uses BrowserRouter, so /albums/<id> is a real URL the browser asks
# Apache for. Without this, that request looks for a directory that does not
# exist and Apache returns 404 — which is why a deep link or a refresh breaks on
# shared hosting while the home page works fine.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite a file or directory that genuinely exists.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand it the app shell.
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Caching.
#
# Vite fingerprints asset filenames, so those are safe to cache for a year. The
# shell must never be cached, or a deploy leaves people on the old bundle until
# they hard-refresh — the exact failure that made the stale demo so confusing.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Force HTTPS — cPanel's AutoSSL issues the certificate, but does not redirect.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
