# Copy this file to `.env` INSIDE /opt/albumflow ON THE SERVER ONLY.
#
#   scp .env.production.example root@80.97.27.100:/opt/albumflow/.env
#   ssh root@80.97.27.100
#   nano /opt/albumflow/.env    # fill in real values below
#
# This file must never be committed, never leave the server, and never be
# copied by the deploy job — it isn't. The deploy job syncs the git checkout,
# which never contains a real `.env`; this file survives every redeploy
# untouched because nothing ever overwrites it.

# hex, not base64 — this value sits directly inside a postgres:// URL below,
# and base64's `/` `+` `=` characters break URL parsing if they show up.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# MinIO's root credentials — also used inside a shell command (mc alias set)
# in docker-compose.prod.yml, so hex again: no quote or `$` characters to
# accidentally break out of that command.
# openssl rand -hex 12   /   openssl rand -hex 24
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# "heuristic" needs no external account and runs entirely on this box.
# Switch to "anthropic" only once ANTHROPIC_API_KEY is set below.
VISION_PROVIDER=heuristic
ANTHROPIC_API_KEY=

# Signs every logged-in user's session token. Anyone who has this can forge a
# login for any account, so it needs real entropy, not a memorable phrase.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Two-tier photo storage (optional). With STORAGE_PROVIDER=none (the default)
# everything stays in the S3/MinIO bucket above, exactly as before.
#
# With "digistorage": full-resolution originals are held in the S3/MinIO bucket
# only as *staging*; web previews go to DigiStorage; and only the originals of
# photos placed on an approved album are copied there. Staged originals are
# deleted ORIGINAL_RETENTION_DAYS after the shoot's latest export completes.
# Use a dedicated DigiStorage *app password* (Preferences -> Password), never
# the main account password, and keep these out of git.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=none
# DIGISTORAGE_WEBDAV_URL=https://storage.rcs-rds.ro/dav/Digi%20Cloud   # NOT app.koofr.net — DigiStorage app passwords only work on its own host
# DIGISTORAGE_USERNAME=          # your DigiStorage login (email)
# DIGISTORAGE_APP_PASSWORD=
# DIGISTORAGE_ROOT_PATH=albumflow
# PUBLIC_API_URL=https://api.example.com   # required with digistorage: preview links point here
# ORIGINAL_RETENTION_DAYS=30     # a shoot with an active client download link is never purged until the link expires
# PREVIEW_LONG_EDGE=1800

# ---------------------------------------------------------------------------
# Email notifications (optional). When a client downloads their photos or sends
# their photo selection, the studio's owner(s) get an email (English + Romanian).
# With EMAIL_PROVIDER=none (the default) the message is only written to the log.
# Any SMTP mailbox works: your domain's mail, Brevo, Gmail (app password), SES...
# Use an app/SMTP password, never the mailbox's main password, and keep it out of git.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=none
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                  # 587 = STARTTLS (SMTP_SECURE=false); 465 = implicit TLS (SMTP_SECURE=true)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="AlbumFlow <notifications@yourdomain.ro>"   # keep the quotes; must be an address your mail server lets you send as
# WEB_ORIGIN=https://app.example.com                   # already set above — the email links here

