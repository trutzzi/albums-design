# Local development: run `docker compose up -d postgres redis minio minio-init`
# then run api/worker/web on the host with `pnpm dev` — these values point at
# the ports docker-compose publishes to localhost.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://albumflow:albumflow@localhost:5432/albumflow
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=albumflow-photos
S3_ACCESS_KEY_ID=albumflow
S3_SECRET_ACCESS_KEY=albumflow123
S3_FORCE_PATH_STYLE=true

WEB_ORIGIN=http://localhost:5173

# Photo categorisation. "heuristic" needs no credentials and runs entirely locally.
# Switch to "anthropic" (and set a key) for real category/face detection.
VISION_PROVIDER=heuristic
# ANTHROPIC_API_KEY=sk-ant-...
