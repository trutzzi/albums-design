{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_*",
        "WEB_ORIGIN",
        "JWT_SECRET",
        "VISION_PROVIDER",
        "OLLAMA_*",
        "ANTHROPIC_API_KEY",
        "STORAGE_PROVIDER",
        "DIGISTORAGE_*",
        "PUBLIC_API_URL",
        "EMAIL_PROVIDER",
        "SMTP_*",
        "MAIL_FROM",
        "LONG_TERM_ORIGINALS",
        "WORKER_CONCURRENCY",
        "ORIGINAL_RETENTION_DAYS",
        "PREVIEW_LONG_EDGE",
        "VITE_*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "demo": {
      "cache": false,
      "persistent": true,
      "env": [
        "VISION_PROVIDER",
        "OLLAMA_BASE_URL",
        "OLLAMA_MODEL",
        "ANTHROPIC_API_KEY",
        "STORAGE_PROVIDER",
        "DIGISTORAGE_WEBDAV_URL",
        "DIGISTORAGE_USERNAME",
        "DIGISTORAGE_APP_PASSWORD",
        "DIGISTORAGE_ROOT_PATH",
        "EMAIL_PROVIDER",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "MAIL_FROM",
        "WEB_ORIGIN",
        "DEMO_OWNER_EMAIL",
        "PORT",
        "DEMO_BASE_URL",
        "PUBLIC_API_URL",
        "LONG_TERM_ORIGINALS",
        "PREVIEW_LONG_EDGE",
        "VITE_*"
      ]
    }
  }
}
